+  // The cap lasts until 00:00 UTC: retrying only burns the retry budget and still fails.
+  describe('daily free cap is not retried', () => {
+    const body = (message: string) =>
+      `429: {"message":"${message}","code":429,"metadata":{"headers":{"X-RateLimit-Limit":"1000","X-RateLimit-Remaining":"0"},"limit_source":"openrouter_free_tier_daily"}}`;
+
+    it('classifies the high-balance wording as quota exhaustion', () => {
+      const msg = createAssistantError(body('Rate limit exceeded: free-models-per-day-high-balance. '));
+      expect(isNonRetryableError(msg)).toBe(true);
+      expect(hasRetryableError(msg)).toBe(false);
+      expect(getErrorCategory(msg.errorMessage!)).toBe('quota');
+    });
+
+    it('classifies by limit_source when the human-readable wording changes', () => {
+      const msg = createAssistantError(body('Daily allowance used up'));
+      expect(isNonRetryableError(msg)).toBe(true);
+      expect(hasRetryableError(msg)).toBe(false);
+      expect(getErrorCategory(msg.errorMessage!)).toBe('quota');
+    });
+
+    it('still retries an ordinary per-minute 429', () => {
+      const msg = createAssistantError('429: {"message":"Rate limit exceeded: free-models-per-min","code":429}');
+      expect(hasRetryableError(msg)).toBe(true);
+    });
+  });
+
   it('keeps Alibaba TPM rate limiting retryable (not a hard quota)', () => {
