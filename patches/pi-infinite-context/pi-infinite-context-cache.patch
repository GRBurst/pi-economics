index 0000000..2ff7e7a
--- /dev/null
+++ b/extensions/infinite-context/fold-hint.test.ts
@@ -0,0 +1,130 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  FOLD_TIMING_TEXT,
+  createFoldTiming,
+  foldHint,
+  foldHintMode,
+  payoffTurns,
+} from "./fold-hint.ts";
+import { planNudge, reminderText } from "./nudge.ts";
+import { DEFAULT_SETTINGS, type FoldHintMode } from "./settings.ts";
+
+// --- cost-aware fold hint (spec 5.3, P-fold) ---
+// Prices are $/MTok: cache write w and cache read r. (w - r) / r is 24 for Opus 5.5 and 11.5 for Sonnet 5.5.
+const OPUS = { w: 5, r: 0.2 };
+const SONNET = { w: 2.5, r: 0.2 };
+const MIN = 60_000;
+const MILLION = 1_000_000;
+
+test("P-fold payoffTurns = ((w - r) / r) * K / R, with the Opus and Sonnet factors of the spec", () => {
+  const near = (actual: number, expected: number) => assert.ok(Math.abs(actual - expected) < 1e-9, `${actual} vs ${expected}`);
+  near(payoffTurns(100_000, 100_000, OPUS), 24);
+  near(payoffTurns(100_000, 100_000, SONNET), 11.5);
+  near(payoffTurns(50_000, 200_000, OPUS), 6);
+});
+
+test("P-fold payoffTurns grows with K (tokens kept after the fold) and shrinks with R (tokens removed)", () => {
+  for (const price of [OPUS, SONNET])
+    for (let k = 10_000; k <= 400_000; k += 30_000)
+      for (let r = 10_000; r <= 400_000; r += 30_000) {
+        assert.ok(payoffTurns(k + 1_000, r, price) > payoffTurns(k, r, price), `K ${k} R ${r}`);
+        assert.ok(payoffTurns(k, r + 1_000, price) < payoffTurns(k, r, price), `K ${k} R ${r}`);
+      }
+});
+
+test("payoffTurns with nothing removed never pays off", () => {
+  assert.equal(payoffTurns(10_000, 0, OPUS), Infinity);
+});
+
+const when = { lastRequestAt: 1_000 * MIN, ttlMs: 5 * MIN };
+
+test("warm: the hint names the payoff in turns and the general rule", () => {
+  const hint = foldHint({ tokens: 400_000, price: OPUS, now: 1_001 * MIN, ...when })!;
+  assert.match(hint, /pays off after ≈ 8 more turns/);
+  assert.match(hint, /24 × K\/R/);
+  const sonnet = foldHint({ tokens: 400_000, price: SONNET, now: 1_001 * MIN, ...when })!;
+  assert.match(sonnet, /pays off after ≈ 4 more turns/);
+  assert.match(sonnet, /11\.5 × K\/R/);
+});
+
+test("cold (now - lastRequestAt >= ttl, boundary included): folding is free now", () => {
+  assert.match(foldHint({ tokens: 400_000, price: OPUS, now: 1_005 * MIN, ...when })!, /cache is cold: folding is free now/);
+  assert.match(foldHint({ tokens: 400_000, price: undefined, now: 1_010 * MIN, ...when })!, /cache is cold: folding is free now/);
+  assert.doesNotMatch(foldHint({ tokens: 400_000, price: OPUS, now: 1_005 * MIN - 1, ...when })!, /cold/);
+});
+
+test("warm without a price for the model: no hint, the fixed marks stay as they are", () => {
+  assert.equal(foldHint({ tokens: 400_000, price: undefined, now: 1_001 * MIN, ...when }), undefined);
+});
+
+test("a session with no request yet counts as cold (resumed session)", () => {
+  assert.match(foldHint({ tokens: 400_000, price: OPUS, lastRequestAt: undefined, ttlMs: 5 * MIN, now: 1 })!, /cache is cold/);
+});
+
+test("the fixed marks still fire and the reminder text keeps its thresholds sentence when a hint is appended", () => {
+  assert.deepEqual(planNudge(150_000, 200_000, DEFAULT_SETTINGS, 0, true), { nudge: true, band: 150_000 });
+  const schedule = { threshold: 150_000, step: 20_000 };
+  const plain = reminderText(152_400, MILLION, schedule);
+  assert.equal(reminderText(152_400, MILLION, schedule, undefined), plain);
+  const text = reminderText(152_400, MILLION, schedule, "HINT");
+  assert.ok(text.startsWith(plain));
+  assert.ok(text.endsWith("HINT"));
+});
+
+// T8.5: the experiments factor `foldHint` (fixed | cache-aware).
+test("mode fixed: no hint, warm or cold; cache-aware (or no mode) unchanged", () => {
+  const base = { tokens: 400_000, price: OPUS, ...when };
+  assert.equal(foldHint({ ...base, now: 1_001 * MIN, mode: "fixed" }), undefined);
+  assert.equal(foldHint({ ...base, now: 1_010 * MIN, mode: "fixed" }), undefined);
+  assert.equal(foldHint({ ...base, now: 1_001 * MIN, mode: "cache-aware" }), foldHint({ ...base, now: 1_001 * MIN }));
+});
+
+test("foldHintMode: a valid experiment flag wins over the own setting, anything else falls back to it", () => {
+  assert.equal(foldHintMode("cache-aware", "fixed"), "fixed");
+  assert.equal(foldHintMode("fixed", "cache-aware"), "cache-aware");
+  assert.equal(foldHintMode("fixed", undefined), "fixed");
+  assert.equal(foldHintMode("cache-aware", "nonsense"), "cache-aware");
+});
+
+// T7.10: the cache-aware level also puts one paragraph in the system prompt, as the prompt section `fold_timing`
+// (before_agent_start mutates event.systemPromptOptions.sections, like task-router's task_cards; no systemPrompt return).
+const FOLD_TIMING =
+  "Fold timing: a fold re-writes the prompt cache from the fold point on. Fold a completed phase promptly, while it is still at the end of the context — that is cheap. Folding old ranges while the cache is warm is expensive; prefer it when the cache is cold or the range is large.";
+
+test("fold timing paragraph: pinned literal, because a model reads it", () => {
+  assert.equal(FOLD_TIMING_TEXT, FOLD_TIMING);
+});
+
+test("fold timing: cache-aware sets exactly the section, fixed removes it and leaves the others alone", () => {
+  const sections = (): Record<string, string> => ({ task_cards: "cards", fold_timing: "stale" });
+  const aware = sections();
+  createFoldTiming(() => "cache-aware")(aware);
+  assert.deepEqual(aware, { task_cards: "cards", fold_timing: FOLD_TIMING });
+  const fixed = sections();
+  createFoldTiming(() => "fixed")(fixed);
+  assert.deepEqual(fixed, { task_cards: "cards" });
+  assert.equal("fold_timing" in fixed, false);
+  const bare: Record<string, string> = {};
+  createFoldTiming(() => "fixed")(bare);
+  assert.deepEqual(bare, {});
+});
+
+test("fold timing: byte-stable across turns, the mode is resolved once per session", () => {
+  const modes: FoldHintMode[] = ["cache-aware", "fixed", "cache-aware", "fixed"];
+  let calls = 0;
+  const timing = createFoldTiming(() => modes[calls++ % modes.length]);
+  const turns = [0, 1, 2].map(() => {
+    const sections: Record<string, string> = { task_cards: "cards" };
+    timing(sections);
+    return JSON.stringify(sections);
+  });
+  assert.equal(turns[0], turns[1]);
+  assert.equal(turns[1], turns[2]);
+  assert.match(turns[0], /Fold timing:/);
+  assert.equal(calls, 1);
+  // a new session resolves again
+  timing.reset();
+  timing({});
+  assert.equal(calls, 2);
+});
