@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { messageItem, originalIds, syncOriginals, wrapRootRanges, type Forest } from "./forest.ts";
+import { abortedRequest, handoffNotice, snapshotHasFolds } from "./robust.ts";
+import { validateToolUnitOwnership } from "./tool-units.ts";
+
+// The shape of the real session that lost its folds (01a0f89b…, entry edeb495e): the question
+// extension recovered a lost answer and the session file got a toolResult in the middle of the
+// history, after the snapshot had been written. Ids and texts are minimal stand-ins.
+const user = (id: string, text: string) => ({ id, type: "message", message: { role: "user", content: text } });
+const call = (id: string, name: string, callId: string) => ({ id, type: "message", message: { role: "assistant", content: [{ type: "toolCall", id: callId, name }] } });
+const result = (id: string, name: string, callId: string, text: string) => ({ id, type: "message", message: { role: "toolResult", toolCallId: callId, toolName: name, content: [{ type: "text", text }] } });
+const other = (id: string, type: string) => ({ id, type });
+
+/** Branch as pi stores it after the recovery: toolResult edeb495e sits between 28d9c3d9 and c4d19b1d. */
+const branch = [
+  user("u1", "task"), call("a1", "bash", "c1"), result("r1", "bash", "c1", "out"),
+  other("snap", "custom"),
+  call("28d9c3d9", "question", "Q"),
+  result("edeb495e", "question", "Q", "No result provided"),
+  other("usage1", "usage"), other("recovery", "custom"),
+  user("c4d19b1d", "recovered answer"), call("3f3532b8", "bash", "c2"), result("r2", "bash", "c2", "ok"),
+];
+const originals = branch.filter((e) => e.type === "message").map((e: any) => ({ id: e.id, message: e.message, live: e.message }));
+const ids = originals.map((o) => o.id);
+/** The snapshot written before the recovery: one fold over the first three entries, no edeb495e. */
+const saved: Forest = wrapRootRanges(
+  ["u1", "a1", "r1", "28d9c3d9", "c4d19b1d", "3f3532b8", "r2"].map(messageItem),
+  [{ first: 0, last: 2, id: "fold-1", summary: "early work" }],
+);
+
+test("unknown-entries: a toolResult in the middle becomes a visible root and the fold is kept", () => {
+  const synced = syncOriginals(saved, ids);
+  assert.deepEqual(synced.map((r) => r.id), ["fold-1", "28d9c3d9", "edeb495e", "c4d19b1d", "3f3532b8", "r2"]);
+  assert.equal(synced[0], saved[0], "the fold is kept as it was");
+  assert.equal(synced[2].kind, "message");
+  assert.deepEqual(originalIds(synced), ids);
+  validateToolUnitOwnership(synced, originals);
+});
+
+test("unknown-entries: several unknown entries keep their order; one before every archived entry goes first", () => {
+  const synced = syncOriginals(saved, ["x1", ...ids.slice(0, 4), "x2", "x3", ...ids.slice(4)]);
+  assert.deepEqual(synced.map((r) => r.id), ["x1", "fold-1", "28d9c3d9", "x2", "x3", "edeb495e", "c4d19b1d", "3f3532b8", "r2"]);
+});
+
+test("unknown-entries: an unknown entry inside a fold's range becomes a root after the fold", () => {
+  const synced = syncOriginals(saved, ["u1", "a1", "new", "r1", ...ids.slice(3)]);
+  assert.deepEqual(synced.slice(0, 2).map((r) => r.id), ["fold-1", "new"]);
+  assert.equal(synced[0], saved[0]);
+});
+
+test("unknown-entries: appended entries still work, and a snapshot without folds resyncs too", () => {
+  assert.deepEqual(syncOriginals(saved, [...originalIds(saved), "tail"]).at(-1)?.id, "tail");
+  assert.deepEqual(syncOriginals([], ids).map((r) => r.id), ids);
+});
+
+test("archived entries missing, repeated or reordered are still rejected", () => {
+  assert.throws(() => syncOriginals(saved, ids.filter((id) => id !== "a1")), /missing from the current branch/);
+  assert.throws(() => syncOriginals(saved, ["u1", "a1", "r1", "c4d19b1d", "28d9c3d9", "edeb495e", "3f3532b8", "r2"]), /in the other order/);
+  assert.throws(() => syncOriginals([messageItem("m"), messageItem("m")], ["m"]), /twice/);
+});
+
+test("a recovered result whose call sits inside a fold cannot be applied: tool unit validation rejects it", () => {
+  const folded = wrapRootRanges(["u1", "a1", "r1", "28d9c3d9", "c4d19b1d", "3f3532b8", "r2"].map(messageItem), [{ first: 3, last: 3, id: "fold-q", summary: "asked" }]);
+  const synced = syncOriginals(folded, ids);
+  assert.throws(() => validateToolUnitOwnership(synced, originals), /splits the tool call/);
+});
+
+test("handoff: an unappliable fold never sends the transcript, only the handoff notice", () => {
+  const sent = abortedRequest("Snapshot does not match the current branch", 42);
+  assert.equal(sent.length, 1);
+  assert.equal(sent[0].role, "user");
+  assert.equal(sent[0].timestamp, 42);
+  assert.match(sent[0].content, /folds could not be applied/);
+  assert.match(sent[0].content, /start a handoff session/);
+  assert.match(sent[0].content, /does not match the current branch/);
+  assert.equal(handoffNotice("x"), sent[0].content.replace("Snapshot does not match the current branch", "x"));
+});
+
+test("snapshotHasFolds: only a saved fold makes the raw transcript unsafe to send", () => {
+  assert.equal(snapshotHasFolds(undefined), false);
+  assert.equal(snapshotHasFolds({ version: 2, roots: [{ kind: "message", id: "a" }] }), false);
+  assert.equal(snapshotHasFolds({ version: 2, roots: [{ kind: "message", id: "a" }, { kind: "fold", id: "f", children: [] }] }), true);
+  assert.equal(snapshotHasFolds({ version: 99, roots: "garbage" }), false);
+  assert.equal(snapshotHasFolds({ version: 2, roots: saved }), true);
+});
