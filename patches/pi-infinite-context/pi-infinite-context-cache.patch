index 0000000..4efef83
--- /dev/null
+++ b/extensions/infinite-context/robust.ts
@@ -0,0 +1,25 @@
+/**
+ * When saved folds cannot be applied, the raw transcript must not go out in their place:
+ * it is several times larger than the folded one (a 150-200k request became 438k). The
+ * request is replaced by a short notice instead and the user hands over to a new session.
+ */
+
+/** True when saved state holds a fold; tolerant of garbage, since this runs on a failed load. */
+export function snapshotHasFolds(data: unknown): boolean {
+  const roots = (data as { roots?: unknown } | undefined)?.roots;
+  if (!Array.isArray(roots)) return false;
+  const pending: unknown[] = [...roots];
+  while (pending.length) {
+    const item = pending.pop() as { kind?: unknown; children?: unknown } | null;
+    if (item?.kind === "fold") return true;
+  }
+  return false;
+}
+
+export const handoffNotice = (reason: string): string =>
+  `infinite-context: folds could not be applied (${reason}). The request carries this notice instead of the raw transcript: start a handoff session.`;
+
+/** The only messages a request carries when its folds cannot be applied. */
+export const abortedRequest = (reason: string, timestamp: number) => [
+  { role: "user" as const, content: handoffNotice(reason), timestamp },
+];
