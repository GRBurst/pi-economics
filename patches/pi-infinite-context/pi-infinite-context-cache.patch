--- /dev/null
+++ b/extensions/infinite-context/fold-hint.ts
@@ -0,0 +1,76 @@
+import type { FoldHintMode, Price } from "./settings.ts";
+
+/**
+ * The cost-aware part of a reminder, and the fold-timing paragraph of the system prompt. Both
+ * follow from what a fold costs: it rewrites the prompt cache from the fold point on.
+ *
+ * Pure: reading prices and the TTL (settings.ts) and the clock is index.ts's job.
+ */
+
+/**
+ * Turns after which a fold has paid for itself. Folding R tokens invalidates the cache of the
+ * K tokens kept after the fold point: rewriting them costs K (w - r) once, and every later turn
+ * saves R r. So payoff = ((w - r) / r) * K / R, about 24 K/R on Opus 5.5 and 11.5 K/R on Sonnet 5.5.
+ */
+export function payoffTurns(keptTokens: number, removedTokens: number, price: Price): number {
+  return removedTokens > 0 ? ((price.w - price.r) / price.r) * (keptTokens / removedTokens) : Infinity;
+}
+
+/** The part of the live context a typical fold removes: the oldest three quarters. */
+const FOLD_REMOVED_SHARE = 0.75;
+
+/**
+ * The cost-aware part of a reminder. Cold cache (`now - lastRequestAt >= ttl`, or no request
+ * yet): the next request rewrites everything anyway, so folding is free. Warm: the payoff of
+ * folding the oldest 75%, plus the general rule so the agent can adapt it. No price for the
+ * model: no hint.
+ */
+export function foldHint(a: {
+  tokens: number;
+  price: Price | undefined;
+  lastRequestAt: number | undefined;
+  now: number;
+  ttlMs: number;
+  mode?: FoldHintMode;
+}): string | undefined {
+  if (a.mode === "fixed") return undefined;
+  if (a.lastRequestAt === undefined || a.now - a.lastRequestAt >= a.ttlMs)
+    return "Fold hint: cache is cold: folding is free now.";
+  if (!a.price) return undefined;
+  const turns = payoffTurns(a.tokens * (1 - FOLD_REMOVED_SHARE), a.tokens * FOLD_REMOVED_SHARE, a.price);
+  const factor = +((a.price.w - a.price.r) / a.price.r).toFixed(1);
+  return (
+    `Fold hint: the cache is warm; folding the oldest ${FOLD_REMOVED_SHARE * 100}% pays off after ≈ ${Math.round(turns)} more turns ` +
+    `(general rule ≈ ${factor} × K/R turns, K = tokens kept after the fold point, R = tokens removed).`
+  );
+}
+
+/** The experiments flag `foldHint` when it names a mode, else the own setting. */
+export function foldHintMode(own: FoldHintMode, flag: string | undefined): FoldHintMode {
+  return flag === "fixed" || flag === "cache-aware" ? flag : own;
+}
+
+/** The `fold_timing` prompt section when the fold hint is cache-aware (before_agent_start). A model reads it: the test pins the literal. */
+export const FOLD_TIMING_TEXT =
+  "Fold timing: a fold re-writes the prompt cache from the fold point on. Fold a completed phase promptly, while it is still at the end of the context — that is cheap. Folding old ranges while the cache is warm is expensive; prefer it when the cache is cold or the range is large.";
+
+/**
+ * The system-prompt side of the cache-aware level: the prompt section `fold_timing`, set on
+ * `event.systemPromptOptions.sections` in before_agent_start (the mechanism task-router uses for
+ * task_cards; pi then appends a transcript delta and other extensions' sections survive).
+ * The mode is resolved on the first turn of a session and kept until `reset()` (session start),
+ * and the text is constant, so the prompt is byte-identical on every turn (a change would rewrite
+ * the prompt cache). `fixed`: the section is removed.
+ */
+export function createFoldTiming(resolveMode: () => FoldHintMode) {
+  let mode: FoldHintMode | undefined;
+  const timing = (sections: Record<string, string>): void => {
+    mode ??= resolveMode();
+    if (mode === "cache-aware") sections.fold_timing = FOLD_TIMING_TEXT;
+    else delete sections.fold_timing;
+  };
+  timing.reset = () => {
+    mode = undefined;
+  };
+  return timing;
+}
