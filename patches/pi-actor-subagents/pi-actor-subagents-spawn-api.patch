@@ -0,0 +1,110 @@
+// Local patch (spawn-api): the policy's child tools and cwd, async tool guards, quiet agents off the roster.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { ChildTool, PolicyResult } from "./api.ts";
+import { persisted, piTool, sessionCwd } from "./child-tools.ts";
+import { Engine } from "./engine.ts";
+import { createSpawner, type SessionLike } from "./spawner.ts";
+import { childToolAllowlist, toolGuardExtensions } from "./tool-guard.ts";
+
+const tool = (r: Awaited<ReturnType<ChildTool["execute"]>>, seen: unknown[] = []): ChildTool => ({
+	name: "submit_verdict",
+	description: "d",
+	parameters: { type: "object" },
+	execute: async (input) => {
+		seen.push(input);
+		return r;
+	},
+});
+
+test("piTool: execute receives the input object itself and maps every isError x terminate combination", async () => {
+	for (const isError of [undefined, false, true])
+		for (const terminate of [undefined, false, true]) {
+			const seen: unknown[] = [];
+			const t = piTool(tool({ text: "recorded", ...(isError !== undefined && { isError }), ...(terminate !== undefined && { terminate }) }, seen));
+			const input = { verdict: "APPROVE" };
+			const out = await t.execute("call-1", input);
+			assert.equal(seen[0], input);
+			assert.deepEqual(out, {
+				content: [{ type: "text", text: "recorded" }],
+				details: {},
+				isError: isError === true,
+				terminate: terminate === true,
+			});
+		}
+	const t = piTool(tool({ text: "x" }));
+	assert.deepEqual([t.name, t.label, t.description, t.parameters], ["submit_verdict", "submit_verdict", "d", { type: "object" }]);
+});
+
+test("allowlist: a child tool joins a policy allowlist like the orchestration tools", () => {
+	const orch = [{ name: "send_message" }];
+	assert.deepEqual(childToolAllowlist(["read"], [...orch, piTool(tool({ text: "x" }))]), ["read", "send_message", "submit_verdict"]);
+});
+
+test("sessionCwd: the policy's cwd, else the fallback", () => {
+	assert.equal(sessionCwd({ cwd: "/wt" }, "/repo"), "/wt");
+	assert.equal(sessionCwd({}, "/repo"), "/repo");
+});
+
+test("async guard: a guard returning a Promise blocks once it resolves; a sync guard stays sync", async () => {
+	const handlers: ((e: { toolName: string; input: unknown }) => unknown)[] = [];
+	const pi = { on: (_: string, h: (typeof handlers)[number]) => void handlers.push(h) };
+	for (const e of toolGuardExtensions(async (name) => (name === "bash" ? "no" : undefined))) e.factory(pi as never);
+	for (const e of toolGuardExtensions(() => "sync no")) e.factory(pi as never);
+	assert.deepEqual(await handlers[0]?.({ toolName: "bash", input: {} }), { block: true, reason: "no" });
+	assert.equal(await handlers[0]?.({ toolName: "read", input: {} }), undefined);
+	assert.deepEqual(handlers[1]?.({ toolName: "x", input: {} }), { block: true, reason: "sync no" });
+});
+
+test("roster: quiet agents are not persisted", () => {
+	const rs = [{ name: "a" }, { name: "q", quiet: true }, { name: "b", quiet: false }];
+	assert.deepEqual(persisted(rs).map((r) => r.name), ["a", "b"]);
+});
+
+type CreateSpec = Parameters<Parameters<typeof createSpawner>[0]["createSession"]>[0];
+function spawnWith(decision: PolicyResult) {
+	const engine = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	engine.addAgent({
+		name: "main",
+		model: "fg/main",
+		handle: { deliver: async () => {}, abort: async () => {} },
+		spawnedBy: "main",
+		depth: 0,
+		createdAt: 0,
+		turns: 0,
+		lastActivity: 0,
+	});
+	const specs: CreateSpec[] = [];
+	const session = {
+		sendAgentMessage: async () => {},
+		thinkingLevel: "high",
+		setThinkingLevel: () => {},
+		subscribe: () => () => {},
+		messages: [],
+	} as Partial<SessionLike> as SessionLike;
+	const spawner = createSpawner({
+		engine,
+		resolveModel: (ref) => (ref ? { provider: "a", id: "b", model: { ref } } : undefined),
+		createSession: async (spec) => {
+			specs.push(spec);
+			return { session, sessionId: "s" };
+		},
+		spawnPolicy: () => () => decision,
+	});
+	return { specs, run: () => spawner.spawnAgent({ name: "w", systemPrompt: "p" }, "main") };
+}
+
+test("spawner passes childTools and cwd exactly when the decision has them", async () => {
+	const base = { model: "a/b", thinkingLevel: "low" } as const;
+	const plain = spawnWith(base);
+	await plain.run();
+	const childTools = [tool({ text: "x" })];
+	const rich = spawnWith({ ...base, childTools, cwd: "/wt" });
+	await rich.run();
+	const { childTools: ct, cwd, ...rest } = rich.specs[0]!;
+	assert.equal(ct, childTools);
+	assert.equal(cwd, "/wt");
+	assert.deepEqual(rest, plain.specs[0]);
+	assert.equal("childTools" in plain.specs[0]!, false);
+	assert.equal("cwd" in plain.specs[0]!, false);
+});
