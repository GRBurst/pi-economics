+/**
+ * Local patch (spawn-api, spawnPolicyApi 2): the pieces index.ts needs for the policy's per-child tools, its
+ * child cwd and quiet agents. SDK-free, so they stay headless-testable.
+ */
+import type { ChildTool } from "./api.ts";
+
+/** A policy's child tool as a pi custom tool: the model's input reaches `execute` unchanged. */
+export function piTool(t: ChildTool) {
+	return {
+		name: t.name,
+		label: t.name,
+		description: t.description,
+		parameters: t.parameters,
+		async execute(_id: string, params: unknown) {
+			const r = await t.execute(params);
+			return {
+				content: [{ type: "text" as const, text: r.text }],
+				details: {},
+				isError: r.isError === true,
+				terminate: r.terminate === true,
+			};
+		},
+	};
+}
+
+/** The child session's cwd: the policy's, else the host's. */
+export const sessionCwd = (spec: { cwd?: string }, fallback: string): string => spec.cwd ?? fallback;
+
+/**
+ * The agents roster.json keeps: a quiet agent (an overseer) is left out, since a restored one would have neither
+ * its child tools nor its ticket and could never report.
+ */
+export const persisted = <R extends { quiet?: boolean }>(rs: R[]): R[] => rs.filter((r) => r.quiet !== true);
