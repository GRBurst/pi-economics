+++ b/extensions/actor-subagents/quiet-control.test.ts
@@ -0,0 +1,122 @@
+// Local patch (spawn-api, review F2): a quiet agent (api.spawn with quiet, a router's overseer) answers only to the API and
+// the human. No agent, its spawner 'main' included, may message, retune, pause, resume or kill it; reading stays open.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { AgentHandle, AgentRecord } from "./agent-record.ts";
+import { makeAgentTools } from "./agent-tools.ts";
+import { installApi, spawnApiDeps } from "./api.ts";
+import { Engine } from "./engine.ts";
+import { createSpawner, type SessionLike } from "./spawner.ts";
+
+const inbox: string[] = [];
+const handle = (name: string): AgentHandle => ({ deliver: async () => void inbox.push(name), abort: async () => {} });
+const record = (name: string, o: Partial<AgentRecord> = {}): AgentRecord => ({
+	name,
+	model: "test/m",
+	handle: handle(name),
+	spawnedBy: "main",
+	depth: name === "main" ? 0 : 1,
+	createdAt: 0,
+	turns: 0,
+	lastActivity: 0,
+	...o,
+});
+/** 'main', a quiet child 'ovs' and a loud child 'w'. */
+function swarm(): Engine {
+	const e = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	e.addAgent(record("main"));
+	e.addAgent(record("ovs", { quiet: true }));
+	e.addAgent(record("w"));
+	return e;
+}
+const REFUSED = "'ovs' was spawned quietly through the API; only the API and the user act on it";
+const refused = [{ target: "ovs", ok: false, reason: REFUSED }];
+
+test("review F2: main's kill, pause, resume and retune refuse a quiet agent with the reason; it stays as it was", async () => {
+	const e = swarm();
+	assert.deepEqual((await e.kill("main", ["ovs"])).results, refused);
+	assert.deepEqual(e.pause("main", ["ovs"]).results, refused);
+	assert.deepEqual((await e.resume("main", ["ovs"])).results, refused);
+	assert.deepEqual(await e.retune("main", "ovs", { thinkingLevel: "low" }), { ok: false, reason: REFUSED });
+	assert.deepEqual(await e.retune("ovs", "ovs", { thinkingLevel: "low" }), { ok: false, reason: REFUSED });
+	assert.equal(e.has("ovs"), true);
+	assert.deepEqual(e.pausedAgents(), []);
+});
+
+test("review F2: a pause or resume without names leaves a quiet child out; the user still reaches it", async () => {
+	const e = swarm();
+	assert.deepEqual(e.pause("main").results, [{ target: "w", ok: true }]);
+	assert.deepEqual(e.pausedAgents(), ["w"]);
+	assert.deepEqual((await e.resume("main")).results, [{ target: "w", ok: true }]);
+	assert.deepEqual(e.pause("restore").results, [{ target: "w", ok: true }]);
+	assert.deepEqual(e.pause("user", ["ovs"]).results, [{ target: "ovs", ok: true }]);
+	assert.deepEqual((await e.resume("user", ["ovs"])).results, [{ target: "ovs", ok: true }]);
+	assert.deepEqual((await e.kill("user", ["ovs"])).results, [{ target: "ovs", ok: true }]);
+});
+
+test("review F2: send_message refuses a quiet target (nothing delivered); the other targets get it ('main', not watched)", async () => {
+	const e = swarm();
+	const tools = makeAgentTools("main", {
+		engine: e,
+		spawnAgent: async () => ({ ok: true, msg: "" }),
+		setAgentModel: async () => ({ ok: true, msg: "" }),
+		resumeAgents: (by, names) => e.resume(by, names),
+		persistRoster: () => {},
+		updateStatus: () => {},
+	});
+	const send = tools.find((t) => t.name === "send_message")!;
+	inbox.length = 0;
+	const r = await send.execute("c1", { to: ["ovs", "main"], content: "approve it" }, undefined, undefined, undefined as never);
+	assert.match((r.content[0] as { text: string }).text, new RegExp(`failed: ovs: ${REFUSED.replace(/[()]/g, "\\$&")}$`));
+	assert.deepEqual(inbox, ["main"]);
+	assert.equal(e.quietRefusal("main", "w"), undefined);
+	assert.equal(e.quietRefusal("user", "ovs"), undefined);
+});
+
+/** The smallest session the spawner can wire; `gate` holds the session's creation. */
+function fakeSession(): SessionLike {
+	return {
+		sendAgentMessage: async () => {},
+		sendUserMessage: async () => {},
+		abort: async () => {},
+		shutdown: async () => {},
+		dispose: () => {},
+		thinkingLevel: "high",
+		setModel: async () => {},
+		setThinkingLevel: () => {},
+		subscribe: () => () => {},
+		getToolDefinition: () => undefined,
+		messages: [],
+		getContextUsage: () => undefined,
+	} as Partial<SessionLike> as SessionLike;
+}
+
+test("review F2: the API kills a quiet agent as 'api' (main's authority); quiet from the reservation on (review L3)", async () => {
+	const e = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	e.addAgent(record("main"));
+	let open!: () => void;
+	const gate = new Promise<void>((r) => {
+		open = r;
+	});
+	const spawner = createSpawner({
+		engine: e,
+		resolveModel: (ref) => (ref ? { provider: "a", id: "b", model: { ref } } : undefined),
+		createSession: async (spec) => {
+			await gate;
+			return { session: fakeSession(), sessionId: `sess-${spec.name}` };
+		},
+		cwd: () => "/repo",
+	});
+	const api = installApi({ engine: e, retune: async () => {}, ...spawnApiDeps({ engine: e, spawnAgent: spawner.spawnAgent, persist: () => {} }) }, {});
+	const spawned = api.spawn!({ name: "ovs", systemPrompt: "s", message: "m", model: "a/b" }, { quiet: true });
+	await new Promise((r) => setTimeout(r, 0));
+	assert.equal(e.get("ovs")?.pending, true);
+	assert.equal(e.quietRefusal("main", "ovs"), REFUSED);
+	assert.deepEqual((await e.kill("main", ["ovs"])).results, refused);
+	open();
+	assert.equal((await spawned).ok, true);
+	const events: { type: string; by?: string }[] = [];
+	e.subscribe((ev) => void events.push(ev));
+	assert.deepEqual(await api.kill!(["ovs"]), ["ovs"]);
+	assert.deepEqual(events.filter((ev) => ev.type === "kill").map((ev) => ev.by), ["api"]);
+});
