diff --git a/extensions/actor-subagents/spawn-api.test.ts b/extensions/actor-subagents/spawn-api.test.ts
new file mode 100644
index 0000000..76ac9db
--- /dev/null
+++ b/extensions/actor-subagents/spawn-api.test.ts
@@ -0,0 +1,150 @@
+// Local patch (spawn-api): api.spawn, api.kill and quiet agents (spawnPolicyApi 2).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { RoutedAgentMessage } from "./agent-message.ts";
+import type { AgentEvent } from "./agent-event.ts";
+import { type Caller, installApi, type InstalledApi, type SpawnArgs, type SpawnPolicy, spawnApiDeps } from "./api.ts";
+import { Engine } from "./engine.ts";
+import { createSpawner, type SessionLike, type ThinkingLevel } from "./spawner.ts";
+
+/** The smallest session the spawner can wire. */
+function fakeSession(): SessionLike {
+	const listeners: ((e: { type: string }) => void)[] = [];
+	let level: ThinkingLevel = "high";
+	return {
+		sendAgentMessage: async () => {
+			setTimeout(() => {
+				for (const l of listeners) l({ type: "turn_start" });
+			}, 0);
+		},
+		sendUserMessage: async () => {},
+		abort: async () => {},
+		shutdown: async () => {},
+		dispose: () => {},
+		get thinkingLevel() {
+			return level;
+		},
+		setModel: async () => {},
+		setThinkingLevel: (l) => {
+			level = l;
+		},
+		subscribe: (l) => {
+			listeners.push(l);
+			return () => {};
+		},
+		getToolDefinition: () => undefined,
+		messages: [],
+		getContextUsage: () => undefined,
+	} as Partial<SessionLike> as SessionLike;
+}
+
+/** An engine with 'main', a spawner reading the API's registered policy, and the API with spawn/kill bound. */
+function setup(policy: SpawnPolicy) {
+	const engine = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	const toMain: RoutedAgentMessage[] = [];
+	engine.addAgent({
+		name: "main",
+		model: "fg/main",
+		thinkingLevel: "xhigh",
+		sessionId: "sess-main",
+		handle: { deliver: async (m) => void toMain.push(m), append: (m) => void toMain.push(m), abort: async () => {} },
+		spawnedBy: "main",
+		depth: 0,
+		createdAt: 0,
+		turns: 0,
+		lastActivity: 0,
+	});
+	const calls: { args: SpawnArgs; caller: Caller }[] = [];
+	let api: InstalledApi | undefined;
+	const spawner = createSpawner({
+		engine,
+		resolveModel: (ref) => {
+			if (!ref) return undefined;
+			const [provider, id] = ref.split("/");
+			return { provider: provider ?? "", id: id ?? "", model: { ref } };
+		},
+		createSession: async (spec) => ({ session: fakeSession(), sessionFile: `/x/${spec.name}.jsonl`, sessionId: `sess-${spec.name}` }),
+		spawnPolicy: () => api?.spawnPolicy(),
+		cwd: () => "/repo",
+	});
+	let persisted = 0;
+	api = installApi(
+		{ engine, retune: async () => {}, ...spawnApiDeps({ engine, spawnAgent: spawner.spawnAgent, persist: () => void persisted++ }) },
+		{},
+	);
+	api.registerSpawnPolicy(async (args, caller) => {
+		calls.push({ args, caller });
+		return policy(args, caller);
+	});
+	const events: AgentEvent[] = [];
+	engine.subscribe((e) => void events.push(e));
+	return { engine, spawner, api, calls, toMain, events, persisted: () => persisted };
+}
+
+const ALLOW: SpawnPolicy = () => ({ model: "a/opus", thinkingLevel: "high" });
+const OVS = { name: "ovs-merge-1", systemPrompt: "s", message: "m", task: { ticket: "t" } };
+
+test("api.spawn runs the registered policy as `by` and resolves with the child's name and session id", async () => {
+	const { api, calls, engine, persisted } = setup(ALLOW);
+	const r = await api.spawn!(OVS, { by: "main", quiet: true });
+	assert.deepEqual(r, { ok: true, name: "ovs-merge-1", sessionId: "sess-ovs-merge-1" });
+	assert.deepEqual(calls[0]?.args.task, { ticket: "t" });
+	assert.equal(calls[0]?.caller.name, "main");
+	assert.equal(engine.get("ovs-merge-1")?.spawnedBy, "main");
+	assert.equal(engine.get("ovs-merge-1")?.quiet, true);
+	assert.equal(persisted(), 1);
+});
+
+test("api.spawn defaults to by 'main' and not quiet", async () => {
+	const { api, engine } = setup(ALLOW);
+	assert.equal((await api.spawn!({ name: "w", systemPrompt: "s", message: "m" })).ok, true);
+	assert.equal(engine.get("w")?.spawnedBy, "main");
+	assert.equal(engine.get("w")?.quiet, false);
+});
+
+test("api.spawn reports a policy reject with its reason and frees the name", async () => {
+	const { api, engine } = setup(() => ({ reject: "no ticket here" }));
+	const r = await api.spawn!(OVS, { quiet: true });
+	assert.equal(r.ok, false);
+	assert.match(r.ok ? "" : r.reason, /no ticket here/);
+	assert.equal(engine.has("ovs-merge-1"), false);
+});
+
+test("api.kill kills as 'main' and resolves with the names taken down", async () => {
+	const { api, events, persisted } = setup(ALLOW);
+	await api.spawn!(OVS, { quiet: true });
+	assert.deepEqual(await api.kill!(["ovs-merge-1"]), ["ovs-merge-1"]);
+	assert.equal(api.list().some((a) => a.name === "ovs-merge-1"), false);
+	assert.deepEqual(
+		events.filter((e) => e.type === "kill").map((e) => [e.name, (e as { by: string }).by]),
+		[["ovs-merge-1", "main"]],
+	);
+	assert.equal(persisted(), 2);
+	assert.deepEqual(await api.kill!(["nobody"]), []);
+});
+
+test("quiet: a quiet child's terminal error and kill reach no parent; a loud child's do", async () => {
+	const { api, engine, toMain } = setup(ALLOW);
+	await api.spawn!({ ...OVS, name: "q" }, { quiet: true });
+	await api.spawn!({ ...OVS, name: "l" }, { quiet: false });
+	toMain.length = 0;
+	engine.setStopReason("q", "error", "boom");
+	await engine.kill("user", ["q"]);
+	await new Promise((r) => setTimeout(r, 0));
+	assert.equal(toMain.length, 0);
+	engine.setStopReason("l", "error", "boom");
+	await engine.kill("user", ["l"]);
+	await new Promise((r) => setTimeout(r, 0));
+	const texts = toMain.flatMap((m) => m.parts.map((p) => p.content));
+	assert.equal(texts.length, 2);
+	assert.match(texts[0] ?? "", /your subagent l entered the error state: boom/);
+	assert.match(texts[1] ?? "", /your subagent l was killed by user/);
+});
+
+test("v1 shape: version 1, and no spawn/kill keys without their deps", () => {
+	const engine = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	const api = installApi({ engine, retune: async () => {} }, {});
+	assert.equal(api.version, 1);
+	assert.equal("spawn" in api, false);
+	assert.equal("kill" in api, false);
+});
