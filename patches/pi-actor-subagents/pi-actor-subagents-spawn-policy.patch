+/**
+ * The spawn_subagent parameter hints, kept out of agent-tools.ts (which needs pi's peer
+ * dependency) so the headless suite can pin them. agent-system-prompt.ts states the same rule
+ * at boot time; change them together.
+ *
+ * Neutral on purpose: a registered spawn policy (api.ts) picks model and effort, so urging the
+ * agent to inherit would contradict it; with no policy, omitting still means inherit.
+ */
+export const SPAWN_MODEL_HINT =
+	"Omit to let the spawn policy decide (inherit if none). Set 'provider/id' only when the user " +
+	"explicitly named a specific model; an unknown value reports available models when any are listed.";
+export const SPAWN_THINKING_HINT =
+	"often described as <model>@<thinking level>. Omit to let the spawn policy decide (inherit if none).";
+export const SPAWN_TASK_HINT =
+	"Optional structured task card for the spawn policy (ignored when none is registered).";
