+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { AgentEvent } from "./agent-event.ts";
+import type { RoutedAgentMessage } from "./agent-message.ts";
+import { Engine } from "./engine.ts";
+import { createErrorNoticeGate } from "./error-notice-gate.ts";
+
+/** Hand-driven clock: timers fire only when the test advances time. */
+function fakeClock() {
+	let now = 0;
+	let next = 0;
+	const timers = new Map<number, { at: number; fn: () => void }>();
+	return {
+		set: (fn: () => void, ms: number) => {
+			timers.set(++next, { at: now + ms, fn });
+			return next;
+		},
+		clear: (id: unknown) => void timers.delete(id as number),
+		advance(ms: number) {
+			now += ms;
+			for (const [id, t] of [...timers].sort((a, b) => a[1].at - b[1].at)) {
+				if (t.at > now) continue;
+				timers.delete(id);
+				t.fn();
+			}
+		},
+	};
+}
+
+/** A parent 'main' with child 'q1', the gate wired to the engine the way index.ts wires it. */
+function setup() {
+	const engine = new Engine({ maxAgents: 8, maxSpawnDepth: 3 });
+	// What the parent actually receives: upstream routes a child's terminal error to it through
+	// Engine.route (a scheduler message), which the gate only delays.
+	const delivered: RoutedAgentMessage[] = [];
+	const base = { model: "m", handle: { deliver: async () => {}, abort: async () => {} }, createdAt: 0, turns: 0, lastActivity: 0 };
+	engine.addAgent({
+		...base,
+		name: "main",
+		spawnedBy: "main",
+		depth: 0,
+		handle: { deliver: async (m: RoutedAgentMessage) => void delivered.push(m), abort: async () => {} },
+	});
+	engine.addAgent({ ...base, name: "q1", spawnedBy: "main", depth: 1 });
