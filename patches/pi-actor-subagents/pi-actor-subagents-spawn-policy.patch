+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { childToolAllowlist, toolGuardExtensions } from "./tool-guard.ts";
+
+/** Loads the inline extensions into a stand-in pi and returns the tool_call handlers they registered. */
+function load(entries: ReturnType<typeof toolGuardExtensions>) {
+	const handlers: ((event: { toolName: string; input: unknown }) => unknown)[] = [];
+	const pi = { on: (event: string, h: (typeof handlers)[number]) => void (event === "tool_call" && handlers.push(h)) };
+	for (const e of entries) e.factory(pi as never);
+	return handlers;
+}
+
+test("a guard reason blocks the tool call with that reason", () => {
+	const seen: unknown[] = [];
+	const [handler] = load(
+		toolGuardExtensions((name, input) => {
+			seen.push([name, input]);
+			return name === "write" ? "scouts are read-only" : undefined;
+		}),
+	);
+	assert.deepEqual(handler?.({ toolName: "write", input: { path: "x" } }), { block: true, reason: "scouts are read-only" });
+	assert.deepEqual(seen, [["write", { path: "x" }]]);
+});
+
+test("a guard that returns undefined lets the call through", () => {
+	const [handler] = load(toolGuardExtensions(() => undefined));
+	assert.equal(handler?.({ toolName: "read", input: {} }), undefined);
+});
+
+test("no guard registers no handler", () => {
+	assert.deepEqual(toolGuardExtensions(undefined), []);
+	assert.equal(load(toolGuardExtensions(undefined)).length, 0);
+});
+
+test("a policy allowlist of ['read'] still leaves the child its orchestration tools", () => {
+	const orchestration = [{ name: "spawn_subagent" }, { name: "send_message" }, { name: "list_subagents" }];
+	const tools = childToolAllowlist(["read"], orchestration);
+	assert.deepEqual(tools, ["read", "spawn_subagent", "send_message", "list_subagents"]);
+	assert.ok(tools?.includes("send_message"));
+	assert.equal(childToolAllowlist(undefined, orchestration), undefined);
+});
diff -ruN a/extensions/actor-subagents/tool-guard.ts b/extensions/actor-subagents/tool-guard.ts
--- a/extensions/actor-subagents/tool-guard.ts
+++ b/extensions/actor-subagents/tool-guard.ts
@@ -0,0 +1,24 @@
+/** The spawn policy's per-child tool guard as an inline child extension (index.ts loads it). */
+export type ToolGuard = (toolName: string, input: unknown) => string | undefined;
+
+type PiLike = { on(event: "tool_call", h: (e: { toolName: string; input: unknown }) => unknown): void };
+
+/** No guard, no extension: an unguarded child gets no tool_call handler at all. */
+export function toolGuardExtensions(guard: ToolGuard | undefined): { name: string; factory: (pi: PiLike) => void }[] {
+	if (!guard) return [];
+	const factory = (pi: PiLike) =>
+		pi.on("tool_call", (e) => {
+			const reason = guard(e.toolName, e.input);
+			return reason === undefined ? undefined : { block: true, reason };
+		});
+	return [{ name: "subagent-tool-guard", factory }];
+}
+
+/**
+ * The tool allowlist a child session is created with. pi's `tools` option filters every tool,
+ * custom ones included, so the policy's list (built-ins + extension tools) is widened by the
+ * orchestration tools actor-subagents hands the child; without them it could not report back.
+ */
+export function childToolAllowlist(policyTools: string[] | undefined, orchestration: { name: string }[]): string[] | undefined {
+	return policyTools ? [...new Set([...policyTools, ...orchestration.map((t) => t.name)])] : undefined;
+}
diff -ruN a/extensions/actor-subagents/usage-line.test.ts b/extensions/actor-subagents/usage-line.test.ts
--- a/extensions/actor-subagents/usage-line.test.ts
+++ b/extensions/actor-subagents/usage-line.test.ts
@@ -0,0 +1,42 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { AgentRecord } from "./agent-record.ts";
+import { agentStatus } from "./agent-status.ts";
+import { formatSnapshot } from "./feed.ts";
+
+const now = 10_000_000;
+const rec = (over: Partial<AgentRecord>): AgentRecord => ({
+	name: "w",
+	model: "anthropic/x",
+	handle: { deliver: async () => {}, abort: async () => {} },
+	spawnedBy: "main",
+	depth: 1,
+	createdAt: 0,
+	turns: 3,
+	lastActivity: now - 4 * 60_000,
+	...over,
+});
+const view = (lastRequestAgoMs: number, tokens: number | null, cost: number) => ({
+	getMessages: () => [{ role: "assistant", timestamp: now - lastRequestAgoMs, usage: { cost: { total: cost } } }],
+	getContextUsage: () => ({ tokens, contextWindow: 200_000, percent: 70 }),
+	subscribe: () => () => {},
+});
+const line = (r: AgentRecord) =>
+	formatSnapshot([{ agent: r, depth: 1 }], "main", agentStatus, now).split("\n")[1] ?? "";
+
+test("list_subagents shows idle time, cache warmth, context size and cost", () => {
+	const out = line(rec({ view: view(4 * 60_000, 143_000, 2.1) }));
+	assert.match(out, /idle=4m cache=warm\(1m left\) ctx=143k \$2\.10$/);
+});
+
+test("the cache reads cold once the 5-minute TTL has passed", () => {
+	assert.match(line(rec({ view: view(6 * 60_000, 900, 0) })), /idle=4m cache=cold ctx=900 \$0\.00$/);
+});
+
+test("a running agent shows no idle time, and missing data is left out", () => {
+	const out = line(rec({ activity: "thinking", view: view(10_000, null, 0.5) }));
+	assert.doesNotMatch(out, /idle=/);
+	assert.match(out, /cache=warm\(4m left\) \$0\.50$/);
+	assert.doesNotMatch(out, /ctx=/);
+	assert.doesNotMatch(line(rec({})), /cache=|\$/);
+});
