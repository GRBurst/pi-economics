+import { test } from "node:test";
+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+import { agentSystemPrompt } from "./agent-system-prompt.ts";
+import { SPAWN_MODEL_HINT, SPAWN_TASK_HINT, SPAWN_THINKING_HINT } from "./spawn-wording.ts";
+
+// agent-tools.ts imports pi's peer dependency, which the headless suite lacks, so its schema is
+// checked as source text; the wording itself lives in spawn-wording.ts and is checked as values.
+const toolsSource = fs.readFileSync(new URL("./agent-tools.ts", import.meta.url), "utf8");
+const inTools = (re: RegExp) => assert.ok(re.test(toolsSource), `agent-tools.ts should match ${re}`);
+
+test("both model hints leave the choice to the spawn policy instead of urging inheritance", () => {
+	const prompt = agentSystemPrompt("w", "p", "main");
+	for (const text of [SPAWN_MODEL_HINT, SPAWN_THINKING_HINT, prompt]) {
+		assert.match(text, /spawn policy decide \(inherit if none\)/);
+		assert.doesNotMatch(text, /almost always correct/);
+		assert.doesNotMatch(text, /inherit yours/);
+	}
+});
+
+test("spawn_subagent takes an optional task object and uses the shared hints", () => {
+	inTools(/task: Type\.Optional\(\s*Type\.Object\(/);
+	inTools(/description: SPAWN_MODEL_HINT/);
+	inTools(/description: SPAWN_THINKING_HINT/);
+	inTools(/description: SPAWN_TASK_HINT/);
+	inTools(/task: args\.task/);
+	assert.ok(!/almost always correct/.test(toolsSource), "agent-tools.ts still urges inheritance");
+	assert.match(SPAWN_TASK_HINT, /spawn policy/);
+});
