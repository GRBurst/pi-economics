--- a/extensions/actor-subagents/error-notice-gate.ts
+++ b/extensions/actor-subagents/error-notice-gate.ts
@@ -0,0 +1,81 @@
+/**
+ * Debounces the "your child entered the error state" message to the parent. SDK-free.
+ *
+ * A child whose provider throttles it (429) errors once per attempt while pi-retry retries it
+ * inline, and every one of those errors used to wake the parent: 15 notices and 18 parent turns
+ * for a 6-step child, with the parent escalating long before the child gave up. So a notice now
+ * waits `graceMs` of quiet: a later error restarts the wait, a successful assistant message or
+ * pi-retry's `completed` drops it, pi-retry's `cancelled` (it gave up) sends it at once. After a
+ * notice, further errors stay silent until the child starts a new turn, so the error that settles
+ * the given-up attempt is not reported twice.
+ *
+ * Only the parent MESSAGE is gated: engine `error` events reach every subscriber immediately.
+ */
+import type { AgentEvent } from "./agent-event.ts";
+
+export type RetrySignal = "started" | "completed" | "cancelled";
+
+type Notice = { name: string; reason: string };
+
+export interface ErrorNoticeGate {
+	onEngineEvent(e: AgentEvent): void;
+	/** A child session event; a successful assistant message counts as recovery. */
+	onSessionEvent(name: string, ev: { type: string; message?: unknown }): void;
+	/** pi-retry's lifecycle in the child session (`pi-retry:<signal>` on its event bus). */
+	onRetry(name: string, signal: RetrySignal): void;
+}
+
+export function createErrorNoticeGate(opts: {
+	graceMs: number;
+	notify: (e: Notice) => void;
+	setTimer?: (fn: () => void, ms: number) => unknown;
+	clearTimer?: (id: unknown) => void;
+}): ErrorNoticeGate {
+	const setTimer =
+		opts.setTimer ??
+		((fn: () => void, ms: number) => {
+			const t = setTimeout(fn, ms);
+			t.unref?.(); // a pending notice must not keep a print-mode pi alive
+			return t;
+		});
+	const clearTimer = opts.clearTimer ?? ((id: unknown) => clearTimeout(id as ReturnType<typeof setTimeout>));
+	const pending = new Map<string, { notice: Notice; timer: unknown }>();
+	// Children already told about, silent until their next turn.
+	const notified = new Set<string>();
+
+	const drop = (name: string) => {
+		const p = pending.get(name);
+		if (p) clearTimer(p.timer);
+		pending.delete(name);
+	};
+	const flush = (name: string) => {
+		const p = pending.get(name);
+		if (!p) return;
+		drop(name);
+		notified.add(name);
+		opts.notify(p.notice);
+	};
+
+	return {
+		onEngineEvent(e) {
+			if (e.type === "turn") notified.delete(e.name);
+			else if (e.type === "kill") {
+				drop(e.name);
+				notified.delete(e.name);
+			} else if (e.type === "error" && !notified.has(e.name)) {
+				drop(e.name);
+				const notice = { name: e.name, reason: e.reason };
+				pending.set(e.name, { notice, timer: setTimer(() => flush(e.name), opts.graceMs) });
+			}
+		},
+		onSessionEvent(name, ev) {
+			if (ev.type !== "message_end") return;
+			const m = ev.message as { role?: string; stopReason?: string } | undefined;
+			if (m?.role === "assistant" && m.stopReason !== "error" && m.stopReason !== "aborted") drop(name);
+		},
+		onRetry(name, signal) {
+			if (signal === "completed") drop(name);
+			else if (signal === "cancelled") flush(name);
+		},
+	};
+}
