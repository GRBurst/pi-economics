diff -ruN a/extensions/actor-subagents/first-turn.test.ts b/extensions/actor-subagents/first-turn.test.ts
--- a/extensions/actor-subagents/first-turn.test.ts
+++ b/extensions/actor-subagents/first-turn.test.ts
@@ -0,0 +1,129 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+	createRoutedAgentMessage,
+	mergeRoutedAgentMessages,
+	toCustomAgentMessage,
+	type CustomAgentMessage,
+} from "./agent-message.ts";
+import { createAgentMessageSender, type AgentMessageTarget } from "./first-turn.ts";
+
+type Call =
+	| { api: "sendUserMessage"; text: string; deliverAs?: string }
+	| { api: "sendCustomMessage"; message: CustomAgentMessage; triggerTurn: boolean; deliverAs?: string };
+
+/**
+ * Stands in for an AgentSession. Only AgentSession.prompt() (which sendUserMessage goes through)
+ * runs before_agent_start and prepares the system prompt and tool loadout, so the API that carries
+ * a message is the whole question; `messages` is the transcript the session reports.
+ */
+class FakeTarget implements AgentMessageTarget {
+	calls: Call[] = [];
+	messages: unknown[] = [];
+	failNextUserMessage = false;
+	async sendUserMessage(text: string, options?: { deliverAs?: "steer" | "followUp" }) {
+		this.calls.push({ api: "sendUserMessage", text, deliverAs: options?.deliverAs });
+		if (this.failNextUserMessage) {
+			this.failNextUserMessage = false;
+			throw new Error("no auth");
+		}
+	}
+	async sendCustomMessage(
+		message: CustomAgentMessage,
+		options: { triggerTurn: true; deliverAs?: "steer" | "followUp" },
+	) {
+		this.calls.push({ api: "sendCustomMessage", message, triggerTurn: options.triggerTurn, deliverAs: options.deliverAs });
+	}
+}
+
+const systemMessage = { role: "system", content: "", sections: { preamble: "x" }, timestamp: 1 };
+
+test("a fresh session's first message is delivered through the prompt path that runs the loadout", async () => {
+	// sendCustomMessage({triggerTurn:true}) on an idle session skips before_agent_start and the
+	// system prompt / tool loadout, so the child's first request would go out without either.
+	const target = new FakeTarget();
+	const send = createAgentMessageSender(target);
+	await send(createRoutedAgentMessage("main", "do X"), { deliverAs: "steer" });
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendUserMessage"],
+	);
+});
+
+test("the first message keeps the text the child saw as a custom message", async () => {
+	const target = new FakeTarget();
+	const send = createAgentMessageSender(target);
+	const message = mergeRoutedAgentMessages([
+		createRoutedAgentMessage("main", "do X"),
+		createRoutedAgentMessage("lead", "and Y"),
+	]);
+	await send(message);
+	assert.equal(target.calls.length, 1);
+	const call = target.calls[0];
+	assert.equal(call.api, "sendUserMessage");
+	assert.equal((call as { text: string }).text, toCustomAgentMessage(message).content);
+	assert.equal((call as { text: string }).text, "[message from main]: do X\n\n[message from lead]: and Y");
+});
+
+test("later messages stay custom messages once the transcript carries the system prompt", async () => {
+	const target = new FakeTarget();
+	const send = createAgentMessageSender(target);
+	await send(createRoutedAgentMessage("main", "first"));
+	target.messages.push(systemMessage, { role: "user" }, { role: "assistant" });
+	await send(createRoutedAgentMessage("main", "second"), { deliverAs: "steer" });
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendUserMessage", "sendCustomMessage"],
+	);
+	const second = target.calls[1] as Extract<Call, { api: "sendCustomMessage" }>;
+	assert.deepEqual(second.message, toCustomAgentMessage(createRoutedAgentMessage("main", "second")));
+	assert.equal(second.triggerTurn, true);
+	assert.equal(second.deliverAs, "steer");
+});
+
+test("a message sent while the first run is still starting is not a second prompt", async () => {
+	// The transcript gets its system message only once the first run is under way; two prompt()
+	// calls on one idle session would race into the same agent run.
+	const target = new FakeTarget();
+	const send = createAgentMessageSender(target);
+	await send(createRoutedAgentMessage("main", "first"));
+	await send(createRoutedAgentMessage("main", "second"), { deliverAs: "steer" });
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendUserMessage", "sendCustomMessage"],
+	);
+});
+
+test("a restored session that already has a system prompt resumes through custom messages", async () => {
+	const target = new FakeTarget();
+	target.messages.push(systemMessage, { role: "user" }, { role: "assistant" });
+	const send = createAgentMessageSender(target);
+	await send(createRoutedAgentMessage("main", "welcome back"));
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendCustomMessage"],
+	);
+});
+
+test("a restored session that never got a system prompt gets one through the prompt path", async () => {
+	const target = new FakeTarget();
+	target.messages.push({ role: "custom", customType: "agent-message" }, { role: "assistant" });
+	const send = createAgentMessageSender(target);
+	await send(createRoutedAgentMessage("main", "welcome back"));
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendUserMessage"],
+	);
+});
+
+test("a failed first delivery is reported and the next message tries the prompt path again", async () => {
+	const target = new FakeTarget();
+	const send = createAgentMessageSender(target);
+	target.failNextUserMessage = true;
+	await assert.rejects(send(createRoutedAgentMessage("main", "first")), /no auth/);
+	await send(createRoutedAgentMessage("main", "retry"));
+	assert.deepEqual(
+		target.calls.map((c) => c.api),
+		["sendUserMessage", "sendUserMessage"],
+	);
+});
diff -ruN a/extensions/actor-subagents/first-turn.ts b/extensions/actor-subagents/first-turn.ts
--- a/extensions/actor-subagents/first-turn.ts
+++ b/extensions/actor-subagents/first-turn.ts
@@ -0,0 +1,67 @@
+/**
+ * How a peer message reaches a child's SDK session.
+ *
+ * pi prepares a run's system prompt and tool loadout (and fires `before_agent_start`) only in
+ * AgentSession.prompt(). `sendCustomMessage(msg, { triggerTurn: true })` on an idle session starts
+ * the run directly, so a child whose first task arrived that way sent its first request without a
+ * system prompt: no agent protocol, no tool guidelines, and no section a `before_agent_start`
+ * extension adds. Every later turn of the run is fine (pi refreshes the loadout between turns),
+ * which is why only the first request looked wrong.
+ *
+ * So the first message of a session that has no system prompt yet goes through the prompt path
+ * (sendUserMessage, i.e. prompt()). The child's model sees the same text as before: pi projects a
+ * custom message to a user message with the same content. What changes is the stored role: the
+ * first task is a user-role entry rather than an `agent-message` custom entry, and it carries its
+ * sender in the `[message from <name>]:` prefix only. Later messages stay custom messages, with
+ * their structured provenance and their own display.
+ */
+import {
+	toCustomAgentMessage,
+	type CustomAgentMessage,
+	type RoutedAgentMessage,
+} from "./agent-message.ts";
+
+type DeliverAs = "steer" | "followUp";
+
+/** The slice of an AgentSession the sender needs. */
+export interface AgentMessageTarget {
+	/** The session transcript, system-prompt update messages included. */
+	readonly messages: readonly unknown[];
+	/** prompt() with `source: "extension"`: runs before_agent_start and the loadout. */
+	sendUserMessage(text: string, options?: { deliverAs?: DeliverAs }): Promise<void>;
+	sendCustomMessage(
+		message: CustomAgentMessage,
+		options: { triggerTurn: true; deliverAs?: DeliverAs },
+	): Promise<void>;
+}
+
+/** True once pi has put a system-prompt update into the transcript, i.e. a run has been prepared. */
+function hasSystemPrompt(messages: readonly unknown[]): boolean {
+	return messages.some((m) => (m as { role?: string } | undefined)?.role === "system");
+}
+
+export function createAgentMessageSender(
+	target: AgentMessageTarget,
+): (message: RoutedAgentMessage, options?: { deliverAs?: DeliverAs }) => Promise<void> {
+	// The transcript only gains its system prompt once the first run is under way, a few awaits
+	// after the prompt call. This flag covers that gap, so a second message cannot become a second
+	// prompt() racing the first into the same run. The transcript stays the truth afterwards.
+	let firstRunRequested = false;
+	return async (message, options) => {
+		if (!firstRunRequested && !hasSystemPrompt(target.messages)) {
+			firstRunRequested = true;
+			try {
+				await target.sendUserMessage(toCustomAgentMessage(message).content, { deliverAs: options?.deliverAs });
+			} catch (error) {
+				// Nothing ran: the session still needs its loadout, so the next message tries again.
+				firstRunRequested = false;
+				throw error;
+			}
+			return;
+		}
+		await target.sendCustomMessage(toCustomAgentMessage(message), {
+			triggerTurn: true,
+			deliverAs: options?.deliverAs,
+		});
+	};
+}
